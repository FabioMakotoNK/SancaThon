# Docker host publishing. Keep 0.0.0.0 to allow ESP32 devices on the LAN;
# restrict access with the host firewall and use only on a trusted network.
CICLOROTA_BIND_ADDRESS=0.0.0.0
CICLOROTA_PORT=8000
CICLOROTA_LOG_LEVEL=info

# Keep the database under /app/data so it remains on the named Docker volume.
CICLOROTA_DB_PATH=/app/data/ciclorota.sqlite3

# The collection days stay fixed; only stops and route order are optimized.
CICLOROTA_FIXED_DAYS=MONDAY,THURSDAY
CICLOROTA_TIMEZONE=America/Sao_Paulo
CICLOROTA_FILL_THRESHOLD=75
CICLOROTA_STALE_SECONDS=21600
CICLOROTA_OFFLINE_SECONDS=86400

# Optional Google Maps Platform credentials. Use separate, restricted keys.
# The browser key is public and should be restricted by website referrer/API.
CICLOROTA_GOOGLE_MAPS_BROWSER_KEY=
# Keep the Geocoding key secret and restrict it to the Geocoding API.
CICLOROTA_GOOGLE_GEOCODING_API_KEY=
CICLOROTA_GOOGLE_MAP_ID=DEMO_MAP_ID
CICLOROTA_GEOCODER_TIMEOUT=5

# Optional OSRM-compatible URL reachable from the container. Leave blank to
# use CicloRota's local approximate-distance fallback.
CICLOROTA_OSRM_URL=
CICLOROTA_OSRM_TIMEOUT=2
CICLOROTA_AVERAGE_SPEED_KMH=30
CICLOROTA_FALLBACK_ROAD_FACTOR=1.25
CICLOROTA_MAX_EXACT_STOPS=12
CICLOROTA_FUEL_L_PER_100KM=18
CICLOROTA_FUEL_COST_BRL_PER_L=6.20
CICLOROTA_CO2_KG_PER_L=2.68
