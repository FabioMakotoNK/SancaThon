#pragma once

// Copy this file to secrets.h and set values for the deployment.
// Keep secrets.h out of source control. The device uses HTTP on a trusted
// development network; use a TLS reverse proxy for a production deployment.
#define WIFI_SSID "replace-with-wifi-name"
#define WIFI_PASSWORD "replace-with-wifi-password"
#define CICLOROTA_ENDPOINT "http://192.168.1.10:8000/api/measurements"
#define DUMPSTER_ID "D001"
#define DEVICE_ID "esp32-D001"

// HC-SR04 TRIG is driven by the ESP32. Protect the 3.3 V ECHO GPIO with
// a level shifter or resistor divider when using a 5 V HC-SR04 module.
#define HC_SR04_TRIG_PIN 5
#define HC_SR04_ECHO_PIN 18

// Per-dumpster calibration from sensor face to empty/full reference levels.
#define EMPTY_DISTANCE_CM 150.0f
#define FULL_DISTANCE_CM 25.0f
#define MEASUREMENT_INTERVAL_MS 60000UL
